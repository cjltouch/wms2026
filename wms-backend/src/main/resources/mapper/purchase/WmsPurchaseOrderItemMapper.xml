<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.wms.business.purchase.mapper.WmsPurchaseOrderItemMapper">

    <delete id="deleteByPurchaseId">
        DELETE FROM wms_purchase_order_item WHERE purchase_id = #{purchaseId}
    </delete>

    <select id="selectByPurchaseId" resultType="com.example.wms.business.purchase.entity.WmsPurchaseOrderItem">
        SELECT * FROM wms_purchase_order_item WHERE purchase_id = #{purchaseId} ORDER BY line_no
    </select>

</mapper>
