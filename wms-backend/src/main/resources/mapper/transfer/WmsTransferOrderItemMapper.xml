<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.wms.business.transfer.mapper.WmsTransferOrderItemMapper">

    <select id="selectByTransferId" resultType="com.example.wms.business.transfer.entity.WmsTransferOrderItem">
        SELECT * FROM wms_transfer_order_item WHERE transfer_id = #{transferId} ORDER BY line_no ASC
    </select>

    <delete id="deleteByTransferId">
        DELETE FROM wms_transfer_order_item WHERE transfer_id = #{transferId}
    </delete>

</mapper>
