<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.wms.business.check.mapper.WmsCheckStatusLogMapper">

    <select id="selectByBillId" resultType="com.example.wms.business.check.entity.WmsCheckStatusLog">
        SELECT * FROM wms_check_status_log WHERE bill_id = #{billId} ORDER BY operate_time ASC
    </select>

</mapper>
